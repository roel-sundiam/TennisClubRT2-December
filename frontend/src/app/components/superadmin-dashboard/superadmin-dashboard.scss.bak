.superadmin-dashboard {
  padding: 24px;
  max-width: 1600px;
  margin: 0 auto;

  // Header
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;

    .header-left {
      h1 {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 8px 0;
        font-size: 32px;
        font-weight: 600;

        mat-icon {
          font-size: 36px;
          width: 36px;
          height: 36px;
        }
      }

      .subtitle {
        margin: 0;
        color: rgba(0, 0, 0, 0.6);
        font-size: 16px;
      }
    }

    .header-right {
      display: flex;
      gap: 16px;
      align-items: center;

      mat-slide-toggle {
        .countdown {
          margin-left: 8px;
          font-size: 12px;
          opacity: 0.8;
        }
      }
    }
  }

  // Loading State
  .loading-container,
  .error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    gap: 16px;

    mat-icon {
      font-size: 64px;
      width: 64px;
      height: 64px;
    }

    p {
      font-size: 18px;
      color: rgba(0, 0, 0, 0.6);
    }
  }

  // Dashboard Content
  .dashboard-content {
    // Court Status Card (Full Width)
    .court-status-card {
      margin-bottom: 24px;

      mat-card-header {
        margin-bottom: 16px;
      }

      .court-status-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;

        .status-section {
          padding: 16px;
          border-radius: 8px;
          border: 2px solid;

          &.current {
            border-color: #4caf50;
            background-color: rgba(76, 175, 80, 0.05);
          }

          &.next {
            border-color: #ff9800;
            background-color: rgba(255, 152, 0, 0.05);
          }

          h3 {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0 0 16px 0;
            font-size: 18px;
            font-weight: 600;

            .status-icon {
              &.active {
                color: #4caf50;
              }

              &.upcoming {
                color: #ff9800;
              }
            }
          }

          .reservation-info {
            display: flex;
            flex-direction: column;
            gap: 12px;

            > div {
              display: flex;
              align-items: center;
              gap: 8px;
              font-size: 16px;

              mat-icon {
                font-size: 20px;
                width: 20px;
                height: 20px;
                opacity: 0.7;
              }
            }

            .member-name {
              font-weight: 600;
              font-size: 18px;
            }

            .players-list {
              font-size: 14px;
              line-height: 1.5;
              color: rgba(0, 0, 0, 0.7);

              strong {
                color: rgba(0, 0, 0, 0.87);
                margin-right: 6px;
              }
            }

            mat-chip {
              margin-top: 8px;
              width: fit-content;
            }
          }

          .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 32px 16px;
            opacity: 0.6;

            mat-icon {
              font-size: 48px;
              width: 48px;
              height: 48px;
              margin-bottom: 8px;
            }

            p {
              margin: 0;
              font-size: 14px;
            }
          }
        }
      }
    }

    // Grid for Remaining Sections
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
      gap: 24px;

      .section-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        max-height: 600px;

        mat-card-content {
          flex: 1;
          overflow-y: auto;
          padding: 16px;
        }

        mat-card-actions {
          padding: 8px 16px;
          margin: 0;
          border-top: 1px solid rgba(0, 0, 0, 0.12);
        }
      }
    }

    // Empty States
    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 48px 16px;
      opacity: 0.6;

      mat-icon {
        font-size: 48px;
        width: 48px;
        height: 48px;
        margin-bottom: 12px;
      }

      p {
        margin: 0;
        font-size: 14px;
      }
    }

    // Table Container
    .table-container {
      overflow-x: auto;

      table {
        width: 100%;
        min-width: 600px;

        th {
          font-weight: 600;
          font-size: 14px;
        }

        td {
          font-size: 14px;
        }

        mat-chip {
          font-size: 12px;
          min-height: 24px;
        }
      }

      .member-info {
        display: flex;
        flex-direction: column;
        gap: 4px;

        strong {
          font-size: 14px;
        }

        small {
          font-size: 12px;
          opacity: 0.7;
        }
      }

      .credit-amount {
        font-weight: 600;
        color: #4caf50;
        font-size: 16px;
      }
    }

    // Payments List
    .payments-list {
      display: flex;
      flex-direction: column;
      gap: 12px;

      .payment-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 8px;
        background-color: rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.12);

        .payment-icon {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 40px;
          height: 40px;
          border-radius: 50%;
          background-color: rgba(63, 81, 181, 0.1);

          mat-icon {
            color: #3f51b5;
          }
        }

        .payment-details {
          flex: 1;

          .payment-member {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 4px;
          }

          .payment-description {
            font-size: 14px;
            color: rgba(0, 0, 0, 0.6);
            margin-bottom: 4px;
          }

          .payment-date {
            font-size: 12px;
            color: rgba(0, 0, 0, 0.5);
          }
        }

        .payment-amount {
          font-size: 18px;
          color: #4caf50;
        }
      }
    }

    // Feedback List
    .feedback-list {
      display: flex;
      flex-direction: column;
      gap: 12px;

      .feedback-item {
        padding: 16px;
        border-radius: 8px;
        background-color: rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.12);
        cursor: pointer;
        transition: all 0.2s ease;

        &:hover {
          background-color: rgba(0, 0, 0, 0.04);
          transform: translateY(-2px);
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .feedback-header {
          display: flex;
          gap: 8px;
          margin-bottom: 12px;

          mat-chip {
            font-size: 11px;
            min-height: 24px;
          }
        }

        .feedback-title {
          font-weight: 600;
          font-size: 16px;
          margin-bottom: 8px;
          line-height: 1.4;
        }

        .feedback-description {
          font-size: 14px;
          color: rgba(0, 0, 0, 0.7);
          margin-bottom: 8px;
          line-height: 1.5;
          max-height: 60px;
          overflow: hidden;
          text-overflow: ellipsis;
          display: -webkit-box;
          -webkit-line-clamp: 3;
          -webkit-box-orient: vertical;
        }

        .feedback-meta {
          font-size: 12px;
          color: rgba(0, 0, 0, 0.5);
          margin-bottom: 8px;

          span {
            margin: 0 4px;

            &:first-child {
              margin-left: 0;
            }
          }
        }

        .feedback-status {
          font-size: 12px;
          min-height: 24px;
        }
      }
    }

    // Tennis Balls Info
    .tennis-balls-info {
      padding: 16px;

      .purchase-member {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 18px;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.12);

        mat-icon {
          color: #3f51b5;
        }
      }

      .purchase-details {
        display: flex;
        flex-direction: column;
        gap: 8px;

        .detail-row {
          display: flex;
          justify-content: space-between;
          font-size: 14px;
          padding: 8px 0;

          .label {
            opacity: 0.7;
          }

          &.total {
            margin-top: 8px;
            padding-top: 12px;
            border-top: 2px solid rgba(0, 0, 0, 0.12);
            font-size: 16px;

            strong {
              color: #4caf50;
            }
          }
        }
      }
    }

    // Page Visits List
    .page-visits-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 450px;
      overflow-y: auto;

      .visit-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 8px;
        background-color: rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.08);

        .visit-icon {
          opacity: 0.5;
          font-size: 20px;
        }

        .visit-details {
          flex: 1;

          .visit-user {
            font-size: 14px;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px;

            strong {
              font-weight: 600;
              font-size: 15px;
              color: rgba(0, 0, 0, 0.87);
            }

            .username-badge {
              font-size: 12px;
              color: rgba(0, 0, 0, 0.5);
              background-color: rgba(0, 0, 0, 0.05);
              padding: 2px 8px;
              border-radius: 12px;
            }
          }

          .visit-page {
            font-size: 13px;
            color: rgba(0, 0, 0, 0.6);
            margin-bottom: 2px;
            display: flex;
            align-items: center;
            gap: 4px;

            .page-icon {
              font-size: 14px;
              width: 14px;
              height: 14px;
              opacity: 0.5;
            }
          }

          .visit-time {
            font-size: 11px;
            color: rgba(0, 0, 0, 0.5);
          }
        }

        .visit-duration {
          display: flex;
          align-items: center;
          gap: 4px;
          font-size: 12px;
          color: rgba(0, 0, 0, 0.6);

          mat-icon {
            font-size: 16px;
            width: 16px;
            height: 16px;
          }
        }
      }
    }
  }
}

// Responsive Design
@media (max-width: 1200px) {
  .superadmin-dashboard {
    .dashboard-content {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }
  }
}

@media (max-width: 768px) {
  .superadmin-dashboard {
    padding: 16px;

    .dashboard-header {
      flex-direction: column;
      align-items: flex-start;

      .header-left h1 {
        font-size: 24px;

        mat-icon {
          font-size: 28px;
          width: 28px;
          height: 28px;
        }
      }

      .header-right {
        width: 100%;
        justify-content: space-between;
      }
    }

    .dashboard-content {
      .court-status-card {
        .court-status-grid {
          grid-template-columns: 1fr;
        }
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .table-container {
        table {
          min-width: 500px;
        }
      }
    }
  }
}

@media (max-width: 480px) {
  .superadmin-dashboard {
    padding: 12px;

    .dashboard-header {
      .header-right {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
    }
  }
}
